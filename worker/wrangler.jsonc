// Cloudflare deploy settings for the d-smp.vip Worker (used by Cloudflare's GitHub deploys and
// by `npx wrangler deploy`). The KV namespace and the D1 database have no ids on purpose:
// Cloudflare creates them on the first deploy and keeps using them after that.
// Secrets (TOKEN, PAYPAL_SECRET) and the dashboard variables (PAYPAL_CLIENT_ID,
// PAYPAL_WEBHOOK_ID) are set in the dashboard and survive deploys (keep_vars).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dsmp-stats",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    { "binding": "STATS", "id": "580b4e72e6314ee8900f8e28e0f14bbf" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "dsmp-store" }
  ],
  "observability": { "enabled": true }
}
